# Generated by Cargo
# Will contain all compiled artifacts, binaries, and dependency builds
/target/

# Backup files generated by rustfmt when formatting code
**/*.rs.bk

# MSVC Windows build debugging files (Microsoft Symbol Server files)
*.pdb

# Mutation testing data generated by cargo-mutants (if used)
**/mutants.out*/

# Internal compiler error stack dumps generated by rustc
rustc-ice-*.txt
